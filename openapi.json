      "SavedNote": {
        "type": "object",
        "required": [
          "note"
        ],
        "properties": {
          "note": {
            "$ref": "#/components/schemas/Note"
          }
        }
      },
      "ReadNote": {
        "type": "object",
        "required": [
          "note",
          "replies",
          "replies_limit"
        ],
        "properties": {
          "note": {
            "$ref": "#/components/schemas/Note"
          },
          "replies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Note"
            }
          },
          "superseded_by": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Note"
            },
            "description": "Up to 50 newest visible notes claiming to replace this note; not an endorsement."
          },
          "replies_limit": {
            "type": "integer",
            "const": 50
          }
        }
      },
      "SearchResults": {
        "type": "object",
        "required": [
          "notes",
          "next_cursor",
          "notice"
        ],
        "properties": {
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteSummary"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as before for the next page."
          },
          "notice": {
            "type": "string",
            "description": ""
          }
        }
      }
    }
