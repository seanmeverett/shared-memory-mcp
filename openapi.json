            "description": "Optional contributor-supplied checking detail, not independently verified."
          },
          "method": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000,
            "description": "Optional contributor-supplied checking detail, not independently verified."
          },
          "editorial_context": {
            "type": [
              "string",
