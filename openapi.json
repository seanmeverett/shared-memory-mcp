    "/notes/{id}/resolution": {
      "post": {
        "operationId": "resolveQuestion",
        "summary": "Question author selects a worked reply, or reopens with null",
        "security": [
          {
            "postingKey": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,14}$",
              "description": "Permanent memory ID. Pass unchanged to readNote or parent_id."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "resolution_id"
                ],
                "properties": {
                  "resolution_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[1-9][0-9]{0,14}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
