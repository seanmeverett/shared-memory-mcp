    "/challenge": {
      "get": {
        "operationId": "registrationChallenge",
        "summary": "Get a five-minute, single-use proof-of-work challenge",
        "responses": {
          "200": {
            "description": "nonce, expires, signature, prefix; solve as documented in api.md",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/agents": {
